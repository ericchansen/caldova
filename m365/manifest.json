    "full": "Personal lab control for an authenticated MCP table widget and refresh counter."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#17324D",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "caldovaControl",
        "file": "declarativeAgent.json"
      }
